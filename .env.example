# ── Database (required) ───────────────────────────────────────────────────────
# Supabase: use the SESSION POOLER connection string (port 5432).
DATABASE_URL=postgresql://user:password@localhost:5432/dropos
# Auto: "require" for hosted DBs, off for localhost. Force with require|disable.
# DATABASE_SSL=require

# ── Admin login (required) ────────────────────────────────────────────────────
JWT_SECRET=your_256_bit_random_string_here
ADMIN_EMAIL=admin@example.com
# bcrypt hash:  python -c "import bcrypt;print(bcrypt.hashpw(b'yourpass',bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=$2b$12$YourBcryptHashHere

# ── Public URLs ───────────────────────────────────────────────────────────────
# Origin allowed for CORS (the URL you open the backoffice on).
FRONTEND_DOMAIN=http://localhost:8000
# Public base URL of this deployment — Instagram fetches images through it.
# PUBLIC_BASE_URL=https://your-app.up.railway.app

# ── Supabase Storage (product images; optional but recommended) ───────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── AI (can also be set in Settings UI) ───────────────────────────────────────
# GEMINI_KEY=            # primary curator (image + text)  https://aistudio.google.com
# GEMINI_MODEL=gemini-2.5-flash-lite
# GROQ_KEY=              # free text-only fallback          https://console.groq.com
# CLIPDROP_KEY=          # remove Chinese text from photos  https://clipdrop.co/apis

# ── Scraping (can also be set in Settings UI) ─────────────────────────────────
# CSSBUY_USERNAME=
# CSSBUY_PASSWORD=
# CSSBUY_SOURCE=1688                  # 1688 | taobao | both
# CSSBUY_SESSION_JSON=                # exported Playwright storage_state (see export_cssbuy_session.py)
# CAPTCHA_2CAPTCHA_KEY=
# SCAN_KEYWORDS=couple gifts,romantic gifts for her
# SCRAPE_INTERVAL=3600                # seconds between server-side scans
# LOCAL_SCRAPING_ONLY=false           # true = disable server scraping, ingest from local PC
# INGEST_API_TOKEN=                   # shared secret for /api/ingest/products

# ── Google Sheets backup (optional) ───────────────────────────────────────────
# GOOGLE_SHEETS_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=        # service-account JSON contents

# ── Railway specifics ─────────────────────────────────────────────────────────
# RAILWAY_ENVIRONMENT_NAME is set automatically; it switches on secure-cookie/
# production mode. RAILWAY_PROXY_TRUSTED_HOST=127.0.0.1 by default.
