# Everything here is OPTIONAL. With no .env at all DropOS starts an embedded
# PostgreSQL in ./data/pg, generates its own JWT secret, and asks you to create
# the admin account in the browser on first start.

# ── Database ──────────────────────────────────────────────────────────────────
# Use an external PostgreSQL instead of the embedded one (e.g. your Supabase DB:
# use the SESSION POOLER connection string, port 5432).
# DATABASE_URL=postgresql://user:password@host:5432/dropos
# Auto: "require" for hosted DBs, off for localhost. Force with require|disable.
# DATABASE_SSL=require

# ── Admin login ───────────────────────────────────────────────────────────────
# Normally created in the browser on first start. Set these to pre-seed/reset it.
# JWT_SECRET=your_256_bit_random_string_here
# ADMIN_EMAIL=admin@example.com
# bcrypt hash:  python -c "import bcrypt;print(bcrypt.hashpw(b'yourpass',bcrypt.gensalt()).decode())"
# ADMIN_PASSWORD_HASH=$2b$12$YourBcryptHashHere

# ── Public URLs (only when the server is reachable from the internet) ─────────
# PUBLIC_BASE_URL=https://dropos.example.com   # webhook URL + image proxy for Instagram
# FRONTEND_DOMAIN=https://dropos.example.com   # extra CORS origin (SPA is same-origin anyway)
# APP_ENV=production                           # hides /docs, tightens CORS
# TRUSTED_PROXY_HOST=127.0.0.1                 # reverse proxy allowed to set X-Forwarded-*

# ── Supabase Storage (re-host product photos on a public URL; free tier) ──────
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── AI (can also be pasted in Settings) ───────────────────────────────────────
# GEMINI_KEY=            # primary curator (image + text)  https://aistudio.google.com
# GEMINI_MODEL=gemini-2.5-flash-lite
# GROQ_KEY=              # free text-only fallback          https://console.groq.com
# CLIPDROP_KEY=          # remove Chinese text from photos  https://clipdrop.co/apis

# ── Scraping (can also be set in Settings) ────────────────────────────────────
# CSSBUY_USERNAME=
# CSSBUY_PASSWORD=
# CSSBUY_SOURCE=1688                  # 1688 | taobao | both
# CSSBUY_SESSION_JSON=                # exported Playwright storage_state (export_cssbuy_session.py)
# CAPTCHA_2CAPTCHA_KEY=               # automatic captcha solving (otherwise solve it in the browser window)
# PLAYWRIGHT_HEADED=1 / PLAYWRIGHT_HEADLESS=1   # force browser window on/off
# SCAN_KEYWORDS=couple gifts,romantic gifts for her
# SCRAPE_INTERVAL=3600                # seconds between automatic scans
# LOCAL_SCRAPING_ONLY=false           # hosted instance only: disable in-server scraping
# INGEST_API_TOKEN=                   # shared secret for /api/ingest/products

# ── Instagram (can also be set in Settings) ───────────────────────────────────
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=
# INSTAGRAM_APP_SECRET=               # verifies webhook signatures

# ── Google Sheets backup (optional) ───────────────────────────────────────────
# GOOGLE_SHEETS_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=        # service-account JSON contents

# ── Data directory ────────────────────────────────────────────────────────────
# DROPOS_DATA_DIR=./data
